<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ae0075a8-3d89-4d1a-9923-1129cd4054e6</UserSecretsId>
    <!-- NuGet 依存を packages.lock.json に固定し、restore の再現性を保証する (サプライチェーン管理 §9)。 -->
    <!-- CI では dotnet restore を locked-mode で実行し、ロックファイルとの一致を強制する。 -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.20" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.20" />
    <!-- 【Microsoft.Data.SqlClient をここにピンしない】SQL Server プロバイダの実体である
         ADO.NET ドライバは、上の Microsoft.EntityFrameworkCore.SqlServer が宣言する版へ
         推移的に解決させる。動作保証があるのはプロバイダが宣言した版に対してだけで、
         直接参照で別の版へ寄せると「ビルドも全テストも緑のまま SQL Server 配備でだけ
         実行時に壊れる」形になる（テストは InMemory / SQLite しか触らない）。
         【以前は床値としてピンしていた（issue #232 で撤去）】EF Core 9.0.19 が宣言していた
         5.1.6 が直前の解決版 5.1.7 より古いサービシングパッチだったため、後退を防ぐ床値として
         5.2.3 を直接参照していた。ところが 5.2 は STS で 5.2.3（2025-04-29）が最後の公開版、
         5.1 は LTS として保守が続き EF Core 9.0.20 の宣言が 5.1.9（2026-01-13）へ上がったため、
         このピンは「後退を防ぐ」どころか**保守の続く系列を押しとどめる**側に反転していた。
         しかも 5.2.3 >= 5.1.9 が数値として成立するので、どの検査も緑のまま気付けなかった。
         【メジャー一致は今も検査している】SqlClientResolvedMajor_MatchesWhatEfCoreDeclares が
         「解決版のメジャー == EF の宣言のメジャー」を見る（宣言側も解決側もロックファイルから
         読むのでピンの有無に依存しない）。撤去で不要になったのは「床値の後退」と「直接参照の維持」
         を見ていた 2 つと、dependabot.yml の major 保留。
         【5.1.x にセキュリティ修正が出たときの取り込み方】推移依存なので Dependabot は直接の
         更新を提案できず、唯一の経路は「推移依存を上げるついでに直接参照へ昇格させる PR」で、
         それは ProductionDirectDependencyTests が落とす。取り込むときは直接参照を戻すと同時に
         同テストの理由付きの表へ登録する（登録の 1 行がレビューに現れるのが狙い）。その際は
         「ピンの値を EF の宣言版以上・現ピン未満へ下げると検査が素通りする」穴
         （CLAUDE.md §3 に記録）も一緒に戻ってくることを承知のうえで決める。
         【メジャーを上げたいとき】そのメジャーを宣言する版の
         Microsoft.EntityFrameworkCore.SqlServer へ同じ変更セットで上げる。EF Core 9.0.x は
         9.0.20 が最後なので、実際には EF Core 10＝net10.0 移行と束ねる話になる。 -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.31" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <!-- TypeScript ソースを追跡対象として MSBuild に登録 (主にエディタ統合と Inputs/Outputs 用) -->
  <ItemGroup>
    <TypeScriptCompile Include="Scripts\**\*.ts" />
    <None Include="..\..\package.json" Link="package.json" />
    <None Include="..\..\tsconfig.json" Link="tsconfig.json" />
  </ItemGroup>

  <!-- TypeScript コンパイル: dotnet build の前に tsc を呼んで wwwroot/js を再生成する。 -->
  <!-- SkipTsBuild=true を環境変数または MSBuild プロパティで指定すれば本ターゲットをスキップ可能 (Node が無い環境向けの逃げ道)。 -->
  <Target Name="CompileTypeScript" BeforeTargets="BeforeBuild" Condition="'$(SkipTsBuild)' != 'true'">
    <!-- node_modules が無ければ npm ci でインストール (CI では事前に npm ci 済みのため通常スキップされる)。 -->
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/../.." Condition="!Exists('$(MSBuildProjectDirectory)/../../node_modules')" />
    <!-- 既にインストール済みの tsc を npx 経由で実行 (no-install フラグで誤って外部取得しに行くのを防ぐ)。 -->
    <Exec Command="npx --no-install tsc" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>

</Project>
