@{
    @* ブラウザタブのタイトル *@
    ViewData["Title"] = "分析・集計";
}

@* 画面タイトル *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-bar-chart-line me-2 text-primary"></i>分析・集計</h2>
</div>

<!-- Charts Grid -->
@* チャートを並べたグリッド *@
<div class="row g-3 mb-4">
    <!-- Monthly Trend (full width) -->
    @* 月別トレンド(横幅いっぱい) *@
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-graph-up me-2 text-primary"></i>月別インシデント発生推移（過去12ヶ月）</h6>
            </div>
            <div class="card-body">
                @* Chart.js の描画先 *@
                <canvas id="trendChart" height="70" role="img" aria-label="月別インシデント発生推移（過去12ヶ月）の折れ線グラフ（データ読み込み中）"></canvas>
            </div>
        </div>
    </div>

    <!-- Cause Category -->
    @* 原因分類別のドーナツチャート *@
    <div class="col-xl-4 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="bi bi-pie-chart me-2 text-info"></i>原因分類別</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="causeChart" height="200" role="img" aria-label="原因分類別インシデント件数のドーナツグラフ（データ読み込み中）"></canvas>
            </div>
        </div>
    </div>

    <!-- By Department -->
    @* 部署別の横棒グラフ *@
    <div class="col-xl-4 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="bi bi-building me-2 text-secondary"></i>部署別インシデント数</h6>
            </div>
            <div class="card-body">
                <canvas id="deptChart" height="200" role="img" aria-label="部署別インシデント件数の横棒グラフ（データ読み込み中）"></canvas>
            </div>
        </div>
    </div>

    <!-- By Severity -->
    @* 重症度別の棒グラフ *@
    <div class="col-xl-4 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="bi bi-exclamation-triangle me-2 text-warning"></i>重症度別分布</h6>
            </div>
            <div class="card-body">
                <canvas id="severityChart" height="200" role="img" aria-label="重症度別インシデント件数の棒グラフ（データ読み込み中）"></canvas>
            </div>
        </div>
    </div>

    <!-- Measure Status -->
    @* 対策の状況(計画/進行/超過/完了)ドーナツチャート *@
    <div class="col-xl-6 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="bi bi-check2-square me-2 text-success"></i>再発防止策 実施状況</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="measureStatusChart" height="180" role="img" aria-label="再発防止策の実施状況（計画中・進行中・期限超過・完了）のドーナツグラフ（データ読み込み中）"></canvas>
            </div>
        </div>
    </div>

    <!-- Effectiveness Rating (most important for evaluation) -->
    @* 有効性評価(1〜5)+ 再発有無の重要指標 *@
    <div class="col-xl-6 col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h6 class="mb-0">
                    <i class="bi bi-star me-2 text-warning"></i>再発防止策 有効性評価分布
                    <span class="badge bg-warning text-dark ms-2 small">重要指標</span>
                </h6>
            </div>
            <div class="card-body">
                <canvas id="effectivenessChart" height="180" role="img" aria-label="再発防止策の有効性評価（★1〜★5）分布の棒グラフ（データ読み込み中）"></canvas>
                @* 再発あり/なしの件数を表示する領域。マークアップはここに静的に置き、 *@
                @* analytics.ts は <strong> の中身(数値)だけを textContent で差し替える(§9 生 HTML 挿入を避ける) *@
                <div class="mt-2 text-center small text-muted">
                    再発なし（対策有効）: <strong class="text-success" id="recurrencePrevented">-</strong>
                    &nbsp;|&nbsp;
                    再発あり（要追加対策）: <strong class="text-danger" id="recurrenceRecurred">-</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- By Incident Type -->
    @* インシデント種別別の棒グラフ(横幅いっぱい) *@
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-0"><i class="bi bi-tags me-2 text-secondary"></i>インシデント種別分布</h6>
            </div>
            <div class="card-body">
                <canvas id="typeChart" height="60" role="img" aria-label="インシデント種別別件数の棒グラフ（データ読み込み中）"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Insights Summary -->
@* 主要指標を一覧表示するサマリーエリア *@
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white">
        <h6 class="mb-0"><i class="bi bi-clipboard-data me-2 text-primary"></i>分析サマリー</h6>
    </div>
    <div class="card-body">
        @* サマリー欄の骨組みは静的に描画し、値の入る要素だけを analytics.ts が textContent で埋める。 *@
        @* 以前はこの領域全体を ByIncidentType の成功コールバックが innerHTML で生成していたため、 *@
        @* その 1 本のフェッチが失敗するとスピナーが永久に回り続けていた(§7 / §6 エラーを握り潰さない)。 *@
        @* 各項目の初期値「-」は、対応するフェッチが完了した時点で数値かエラー文言に置き換わる。 *@
        <div class="row g-3">
            <div class="col-md-2 text-center border-end">
                <div class="text-muted small">最多発生部署</div>
                <div class="fw-bold" id="topDept">-</div>
            </div>
            <div class="col-md-2 text-center border-end">
                <div class="text-muted small">最多インシデント種別</div>
                <div class="fw-bold" id="topType">-</div>
            </div>
            <div class="col-md-2 text-center border-end">
                <div class="text-muted small">対策完了率</div>
                <div class="fw-bold fs-5 text-success" id="completionRate">-</div>
            </div>
            <div class="col-md-2 text-center border-end">
                <div class="text-muted small text-danger">再発確認対策数</div>
                <div class="fw-bold fs-5 text-danger" id="failedMeasures">-</div>
            </div>
            <div class="col-md-2 text-center">
                <div class="text-muted small">期限超過対策数</div>
                <div class="fw-bold fs-5 text-warning" id="overdueMeasures">-</div>
            </div>
        </div>
    </div>
</div>

@* ページ固有の JavaScript(Chart.js 初期化) *@
@* Razor から TypeScript (Scripts/analytics.ts) へデータを渡す仕組みは *@
@* Views/Home/Index.cshtml → Scripts/dashboard.ts と同じ 2 段構成に揃えている: *@
@*   1) <script type="application/json"> でデータを埋め込む(HTML エスケープ済み) *@
@*   2) analytics.js が IIFE で起動し、その JSON を読み取って各 JSON API を叩き Chart.js を初期化する *@
@* これにより従来 330 行あった inline script が TypeScript の型チェック対象になる *@
@section Scripts {
    @* 分析画面用データ(各 API の URL・重症度の配色・バケット引き当て用ラベル) *@
    <script id="analytics-data" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            // 各 JSON API の URL。JS 側でルートを直書きするとリバースプロキシのサブパス配備で
            // PathBase が付かず 404 になるため、サーバー側で生成して渡す
            urls = new {
                monthlyTrend = Url.Action("MonthlyTrend", "Analytics"),
                byCause = Url.Action("ByCause", "Analytics"),
                byDepartment = Url.Action("ByDepartment", "Analytics"),
                bySeverity = Url.Action("BySeverity", "Analytics"),
                measureStatus = Url.Action("MeasureStatus", "Analytics"),
                effectivenessRating = Url.Action("EffectivenessRating", "Analytics"),
                byIncidentType = Url.Action("ByIncidentType", "Analytics")
            },
            // 重症度別グラフの配色。BySeverity は enum 定義順で全重症度を返すため、
            // 同じ順序で EnumLabels(色の一元管理元)からバッジと同じ配色を生成する。
            // JS 側に16進値を直書きすると EnumLabels とズレたときに気づけない(§6)
            severityColors = IncidentInsight.Web.Models.Enums.EnumLabels.AllSeverities
                .Select(s => IncidentInsight.Web.Models.Enums.EnumLabels.Hex(
                    IncidentInsight.Web.Models.Enums.EnumLabels.Color(s))),
            // MeasureStatus の labels 配列から「期限超過」「完了」のバケットを引き当てるためのラベル。
            // 位置(インデックス)で取り出すとバケットの増減で黙って別の数値を表示するため、
            // AnalyticsController と同じ EnumLabels 由来のラベルで一致検索させる(§6)
            measureStatusLabels = new {
                overdue = IncidentInsight.Web.Models.Enums.EnumLabels.MeasureOverdueLabel,
                completed = IncidentInsight.Web.Models.Enums.EnumLabels.Japanese(
                    IncidentInsight.Web.Models.Enums.MeasureStatus.Completed)
            }
        }))
    </script>
    @* TypeScript からコンパイルされた analytics.js を読み込む *@
    @* CDN の Chart.js (グローバル Chart) はレイアウトで先に読み込まれているため、この時点で利用可能 *@
    <script src="~/js/analytics.js" asp-append-version="true"></script>
}
