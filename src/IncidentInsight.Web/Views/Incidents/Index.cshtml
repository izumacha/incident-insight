@* 一覧画面の ViewModel（絞り込み条件・表示件数・検索結果・ページ情報をまとめた入れ物） *@
@model IncidentInsight.Web.Models.ViewModels.IncidentListViewModel
@* IClock を DI で受け取り、今日の日付を DateTime.Today 直呼びなしで取得する *@
@inject IncidentInsight.Web.Services.IClock Clock
@{
    @* ブラウザタブのタイトル *@
    ViewData["Title"] = "インシデント一覧";
    @* 今日の日付を一度だけ取得してビュー内で使い回す *@
    var today = Clock.Today;
}

@* ページヘッダ：見出しと新規登録ボタン *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-clipboard2-pulse me-2 text-primary"></i>インシデント一覧</h2>
    @* 新規登録画面への遷移 *@
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>新規登録
    </a>
</div>

@* 「絞り込み値を受け取ったのに採用しなかった」注意書き 3 件。
   なぜ黙って落とさないのかは Models/Validation/SearchFilter の解説が正本。

   枠(警告の見た目・アイコン・role="alert"・§7 の配慮)は 3 件で同じなので
   共有パーシャル _FilterIgnoredNotice が持ち、ここは「どの旗のときに、どの文面を出すか」
   だけを決める。出し分けの @if をこちらに残しているのは、旗が実際に読まれていることを
   UnlistedFilterValuePolicyTests が Index.cshtml 上で固定しているため
   （条件までパーシャルへ寄せると、新しい旗が誰にも読まれない書き込み専用の
   プロパティになっても気付けない） *@

@* 部署: 送られてきた値そのものは出さない。外部由来の文字列をアプリ自身の文章へ
   埋め込むと、整形するほど「表示した文字列」と「実際に照会した文字列」が食い違い、
   事実と逆の案内になる(理由は IncidentListViewModel を参照)。
   何を送ったかはアドレス欄に出ており、下の絞り込みパネルも開くので選び直せる。
   文面はその条件だけに限る。「絞り込まずに一覧を表示しています」と書くと、
   ?department=<誤り>&severity=Level5 のように他の条件が効いている場合に事実と違ううえ、
   同じ画面の「フィルター適用中」バッジと真逆のことを言う *@
@if (Model.DepartmentFilterIgnored)
{
    <partial name="_FilterIgnoredNotice" model="@(new FilterIgnoredNotice(
        "部署の絞り込みは適用していません。",
        "指定された部署のインシデントが（表示できる範囲に）1 件も無いため、部署の条件を外して一覧を表示しています。"
        + "絞り込みたい部署は下の「絞り込み」から選び直してください。"))" />
}

@* 原因分類: 出す理由・値そのものを出さない理由は上の部署と同じ（説明はそちらが正本）。
   文面だけ分けているのは「採用しなかった理由」が違うため —— 部署は
   「その部署の行が見える範囲に無い」、原因分類は「その分類がマスタに無い」 *@
@if (Model.CauseCategoryFilterIgnored)
{
    <partial name="_FilterIgnoredNotice" model="@(new FilterIgnoredNotice(
        "原因分類の絞り込みは適用していません。",
        "指定された原因分類が見つからないため、原因分類の条件を外して一覧を表示しています。"
        + "絞り込みたい原因分類は下の「絞り込み」から選び直してください。"))" />
}

@* 型として読めない値: 上の 2 つと違い、対象の入力（種別・重症度・発生日の開始/終了・
   原因分類）をここで名指ししない。採用しなかった理由が 5 つとも同一なので文面を
   分ける根拠が無く、分ければ同じ文章が 5 つ並ぶ（理由の正本は
   Controllers/Internal/MalformedFilterValueResolver の解説。issue #198）。
   どの条件を送ったかはアドレス欄に出ており、パネルも開くので選び直せる *@
@if (Model.MalformedFilterIgnored)
{
    <partial name="_FilterIgnoredNotice" model="@(new FilterIgnoredNotice(
        "一部の絞り込みは適用していません。",
        "指定された条件のうち、値として読み取れないものがあったため、その条件を外して一覧を表示しています。"
        + "絞り込みたい条件は下の「絞り込み」から指定し直してください。"))" />
}

@* 絞り込みパネル *@
@{
    @* 何らかの絞り込み条件が指定されているかの判定（1つでも入っていれば true）。
       文字列条件はコントローラが絞り込みを適用するときとまったく同じ SearchFilter.HasValue を通す。
       ここだけ判定がずれると、空白のみの入力で「絞り込み中」と表示しながら全件を返す食い違いになる *@
    var anyFilter = SearchFilter.HasValue(Model.Search) || SearchFilter.HasValue(Model.Department)
                 || Model.IncidentType.HasValue || Model.Severity.HasValue
                 || Model.DateFrom.HasValue || Model.DateTo.HasValue || Model.CauseCategoryId.HasValue;

    @* パネルを開くかどうかだけは「採用しなかった部署値」も数える。
       anyFilter 自体には足さない —— あれは「絞り込みが実際に効いているか」で、
       バッジ（フィルター適用中）と 0 件時の文言（「条件に一致しません／クリア」対
       「まだ登録されていません」）の出し分けにも使う。採用しなかった値を混ぜると、
       注意書きが「適用していません」と言う横でバッジが「適用中」と言い、
       1 件も無い環境では効いていないフィルターを「クリアしてください」と促してしまう。
       一方パネルは開いておきたい: 送った値を選び直せる場所がそこにしか無いため *@
    var showFilterPanel = anyFilter || Model.DepartmentFilterIgnored || Model.CauseCategoryFilterIgnored
                       || Model.MalformedFilterIgnored;
}
<div class="card border-0 shadow-sm mb-3">
    @* クリックで折りたたみを開閉するヘッダ。div+role="button" だとキーボードで
       フォーカス・操作できない(§7)ため、ネイティブにフォーカス可能な <a href> を使う *@
    <a class="card-header bg-white d-block text-decoration-none text-body" href="#filterPanel"
       data-bs-toggle="collapse" role="button"
       aria-expanded="@(showFilterPanel ? "true" : "false")" aria-controls="filterPanel">
        <i class="bi bi-funnel me-2"></i>絞り込み
        @* フィルター適用中の目印バッジ *@
        @if (anyFilter)
        {
            <span class="badge bg-primary ms-2">フィルター適用中</span>
        }
    </a>
    @* フィルター適用中、または採用しなかった値があるときは初期表示で開いておく *@
    <div class="collapse @(showFilterPanel ? "show" : "")" id="filterPanel">
        <div class="card-body">
            @* GET で送信して URL に絞り込み条件を残す（共有・ブックマーク可能にする） *@
            <form method="get" asp-action="Index">
                <div class="row g-2">
                    <div class="col-md-3">
                        @* キーワード検索（内容・報告者を対象）。placeholder はスクリーンリーダーの
                           ラベルとして不十分なため aria-label を併記する(§7) *@
                        <input type="text" name="search" class="form-control form-control-sm"
                               aria-label="キーワード検索（内容・報告者）"
                               placeholder="キーワード検索（内容・報告者）" value="@Model.Search" />
                    </div>
                    <div class="col-md-2">
                        @* 部署フィルター。
                           選択肢は部署一覧の static 配列を直接回さず ViewModel から受け取る
                           （コントローラが補完した値ごと渡ってくる。なぜ補完が要るのかは
                           Models/Validation/SearchFilter の解説が正本。issue #192）。
                           配線は UnlistedFilterValuePolicyTests が見張っており、
                           select ブロックの foreach が「何を」回しているかを直接見る
                           (Razor のコメントは取り除いてから判定するので、この注記を
                           ブロックの内外どちらに置いても検査の結果は変わらない) *@
                        <select name="department" class="form-select form-select-sm" aria-label="部署で絞り込み">
                            <option value="">部署（全て）</option>
                            @foreach (var d in Model.DepartmentOptions)
                            {
                                @* 現在値と一致すれば selected に *@
                                <option value="@d" selected="@(Model.Department == d)">@d</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        @* 種別フィルター *@
                        <select name="incidentType" class="form-select form-select-sm" aria-label="種別で絞り込み">
                            <option value="">種別（全て）</option>
                            @foreach (var t in IncidentInsight.Web.Models.Enums.IncidentTypeMapping.AllInDisplayOrder)
                            {
                                <option value="@t" selected="@(Model.IncidentType == t)">@IncidentInsight.Web.Models.Enums.IncidentTypeMapping.JapaneseLabel(t)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        @* 重症度フィルター *@
                        <select name="severity" class="form-select form-select-sm" aria-label="重症度で絞り込み">
                            <option value="">重症度（全て）</option>
                            @foreach (var s in IncidentInsight.Web.Models.Enums.EnumLabels.AllSeverities)
                            {
                                <option value="@s" selected="@(Model.Severity == s)">@IncidentInsight.Web.Models.Enums.EnumLabels.Japanese(s)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        @* 原因分類フィルター。選択肢は「親カテゴリのみ」だが、
                           コントローラの絞り込みは子カテゴリの id も受け付けるため、
                           子の id で絞り込んでいるときはその 1 件が「親名 > 子名」の見出しで
                           先頭に補完されて渡ってくる（なぜ補完が要るのかは
                           Models/Validation/SearchFilter の解説が正本。issue #195）。
                           部署と同じく静的な一覧を直接回さず ViewModel から受け取る *@
                        <select name="causeCategoryId" class="form-select form-select-sm" aria-label="原因分類で絞り込み">
                            <option value="">原因分類（全て）</option>
                            @foreach (var opt in Model.CauseCategoryOptions)
                            {
                                <option value="@opt.Value" selected="@(Model.CauseCategoryId?.ToString() == opt.Value)">@opt.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        @* 検索実行ボタン *@
                        <button type="submit" class="btn btn-primary btn-sm w-100">検索</button>
                    </div>
                </div>
                <div class="row g-2 mt-1 align-items-end">
                    <div class="col-md-2">
                        @* 発生日開始 *@
                        <label class="form-label small mb-0">発生日（開始）</label>
                        <input type="date" name="dateFrom" class="form-control form-control-sm"
                               value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-2">
                        @* 発生日終了 *@
                        <label class="form-label small mb-0">発生日（終了）</label>
                        <input type="date" name="dateTo" class="form-control form-control-sm"
                               value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-2">
                        @* 並び替え指定 *@
                        <label class="form-label small mb-0">並び順</label>
                        <select name="sortBy" class="form-select form-select-sm">
                            <option value="latest" selected="@(Model.SortBy != "severity" && Model.SortBy != "overdue")">最新順</option>
                            <option value="severity" selected="@(Model.SortBy == "severity")">重症度高順</option>
                            <option value="overdue" selected="@(Model.SortBy == "overdue")">未完了対策あり優先</option>
                        </select>
                    </div>
                    <div class="col-md-auto">
                        @* フィルタークリア（条件無しで再アクセス） *@
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">クリア</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@* 検索結果エリア *@
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between">
        @* 表示件数の案内（ページングの現在位置） *@
        <span class="text-muted small">@Model.TotalCount 件中 @((Model.Page - 1) * Model.PageSize + (Model.TotalCount > 0 ? 1 : 0))〜@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) 件表示</span>
    </div>
    @* 0件の場合の空表示 *@
    @if (!Model.Incidents.Any())
    {
        @* フィルター適用中かどうかは冒頭で判定済みの anyFilter を再利用する(§6 DRY)。
           条件を書き写すと原因分類のように判定漏れ(ドリフト)が起きるため一本化する *@
        if (anyFilter)
        {
            @* フィルターを外せば結果が出る可能性を示すメッセージ *@
            <div class="card-body text-center py-5">
                <i class="bi bi-search display-4 text-muted d-block mb-3"></i>
                <h5 class="text-muted">絞り込み条件に一致するインシデントはありません</h5>
                <p class="text-muted small mb-3">検索条件を変更するか、フィルターをクリアしてください</p>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>フィルターをクリア
                </a>
            </div>
        }
        else
        {
            @* 1件も未登録のときはオンボーディングを促す *@
            <div class="card-body text-center py-5">
                <i class="bi bi-clipboard2-plus display-4 text-primary d-block mb-3"></i>
                <h5>インシデントがまだ登録されていません</h5>
                <p class="text-muted mb-3">インシデントを登録して、再発防止の取り組みを始めましょう。</p>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle me-2"></i>最初のインシデントを登録する
                </a>
            </div>
        }
    }
    else
    {
        @* 検索結果テーブル *@
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">発生日時</th>
                        <th>部署</th>
                        <th>種別</th>
                        <th>重症度</th>
                        <th>報告者</th>
                        <th>対策状況</th>
                        <th class="text-end pe-3">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @* 検索結果を1件ずつ行で描画 *@
                    @foreach (var incident in Model.Incidents)
                    {
                        @* 期限超過対策があれば赤背景で強調(IClock 経由の today を渡す) *@
                        <tr class="@(incident.PreventiveMeasures.Any(m => m.IsOverdueOn(today)) ? "table-danger" : "")">
                            <td class="ps-3">
                                @* 発生日 *@
                                <div>@incident.OccurredAt.ToString("yyyy/MM/dd")</div>
                                @* 発生時刻 *@
                                <div class="text-muted small">@incident.OccurredAt.ToString("HH:mm")</div>
                            </td>
                            <td>@incident.Department</td>
                            <td>
                                @* インシデント種別バッジ *@
                                <span class="badge bg-secondary">@incident.IncidentTypeLabel</span>
                            </td>
                            <td>
                                @* 重症度バッジ（色はモデル計算プロパティに一任） *@
                                <span class="badge bg-@incident.SeverityColor">@incident.SeverityLabel</span>
                            </td>
                            <td>@incident.ReporterName</td>
                            <td>
                                @* 対策状況サマリ（未着手／進行中／完了 等）(IClock 経由の today を渡す) *@
                                <span class="badge bg-@incident.MeasureStatusColorOn(today)">@incident.MeasureStatusSummaryOn(today)</span>
                            </td>
                            <td class="text-end pe-3">
                                @* 詳細画面への遷移 *@
                                <a asp-action="Details" asp-route-id="@incident.Id" class="btn btn-sm btn-outline-primary">詳細</a>
                                @* 編集画面への遷移 *@
                                <a asp-action="Edit" asp-route-id="@incident.Id" class="btn btn-sm btn-outline-secondary">編集</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ページネーション（AuditLogs 一覧と共通の _Pager パーシャル。±窓 + 先頭/末尾ジャンプ付き） *@
@{
    @* ページャ部品へ渡すモデル（現在ページ・総ページ数・URL に引き継ぐ絞り込み条件） *@
    var pager = new PagerViewModel
    {
        Page = Model.Page,
        TotalPages = Model.TotalPages,
        RouteValues = new Dictionary<string, string?>
        {
            ["search"] = Model.Search,
            ["department"] = Model.Department,
            ["incidentType"] = Model.IncidentType?.ToString(),
            ["severity"] = Model.Severity?.ToString(),
            ["dateFrom"] = Model.DateFrom?.ToString("yyyy-MM-dd"),
            ["dateTo"] = Model.DateTo?.ToString("yyyy-MM-dd"),
            ["causeCategoryId"] = Model.CauseCategoryId?.ToString(),
            ["sortBy"] = Model.SortBy
        }
    };
}
<partial name="_Pager" model="pager" />
